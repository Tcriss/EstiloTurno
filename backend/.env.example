PORT=3301

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
DATABASE_URL=

CORS_ORIGINS=

JWT_SECRET=
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_URL=http://localhost:3000

# Sin SMTP_HOST, el link de reset de contraseña se loguea por consola en vez de enviarse por correo.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

LLM_PROVIDER=  # anthropic | openai | gemini

LLM_API_KEY=
LLM_MODEL=

# Específicas por proveedor — podés tener las tres cargadas a la vez
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=           # default: claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=              # default: gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=              # default: gemini-flash-latest

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=   # debe coincidir EXACTO con la redirect URI en Google Cloud Console
CALENDAR_TOKEN_ENCRYPTION_KEY=  # ej: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<una-password-nueva-y-distinta-a-la-hardcodeada>
POSTGRES_DB=
